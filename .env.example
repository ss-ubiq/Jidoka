# JIDOKA website — public site configuration.
# The site is fully functional with NONE of these set (RFQ falls back to mailto/logging).

# Public contact surface (used in header, footer, contact page, RFQ confirmations).
# These defaults are already baked into the app; override here only if they change.
NEXT_PUBLIC_JIDOKA_EMAIL=info@jidoka.in
NEXT_PUBLIC_JIDOKA_PHONE=+91-8826002054
NEXT_PUBLIC_JIDOKA_WHATSAPP=918826002054   # digits only, country code, no + (leave blank if not on WhatsApp)
# Map pin for "Get directions". Defaults to the building landmark (ATS Bouquet, Sector 132).
# For an EXACT pin: open your location in Google Maps → Share → copy either the "lat,lng"
# or the place, and put it here, e.g. NEXT_PUBLIC_MAPS_QUERY=28.5245,77.3910
NEXT_PUBLIC_MAPS_QUERY=

# Clean integration point with Branch 1 (JIDOKA AI Revenue Manager).
# When set, RFQ / requirement submissions POST here to become qualified leads.
# Leave blank to store submissions locally / send by email instead.
RFQ_FORWARD_URL=
RFQ_FORWARD_TOKEN=

# RFQ delivery by email (LAUNCH-CRITICAL — set these so enquiries actually reach the team).
# Any SMTP works (no paid SaaS). Gmail example:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_USER=you@gmail.com
#   SMTP_PASS=<16-char Google "App Password">   (Google account → Security → App passwords)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Where enquiries are sent (defaults to NEXT_PUBLIC_JIDOKA_EMAIL). Sender shown on the email:
RFQ_TO=
EMAIL_FROM=

# Optional: self-hostable analytics sink (e.g. Plausible/Umami/own endpoint).
# Leave blank to log events server-side. No cookies, no personal data, honours Do-Not-Track.
ANALYTICS_FORWARD_URL=

# Where catalogue PDFs are served from. Blank = local /public/catalogues (self-host).
# For hosts without the 2 GB PDFs (Netlify etc.), set a public base URL that contains the PDFs.
NEXT_PUBLIC_CATALOGUE_BASE=
